#!/bin/bash
# SmartKeys — antes de instalar la app Standalone: borra la versión anterior
SK_DIR="$(cd "$(dirname "$0")" && pwd)"
# Dentro del .pkg las funciones van junto al script; en el repositorio, una carpeta arriba
if [ -f "$SK_DIR/cleanup_common.sh" ]; then source "$SK_DIR/cleanup_common.sh"; else source "$SK_DIR/../cleanup_common.sh"; fi
sk_log "== preinstall App =="
sk_remove "/Applications/SmartKeys.app"
while IFS= read -r home; do
    sk_remove "$home/Applications/SmartKeys.app"
done < <(sk_user_homes)
exit 0
