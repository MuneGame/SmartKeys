<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Pruebas de SmartKeys en macOS: como cualquier DAW, el ejecutable declara
     que usa el micrófono (si no, SmartKeys no lo abre). -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.miwn.smartkeys.tests</string>
    <key>CFBundleName</key>
    <string>SmartKeysTests</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Prueba automática de SmartKeys: lee el micrófono para comprobar la detección de voz.</string>
</dict>
</plist>
